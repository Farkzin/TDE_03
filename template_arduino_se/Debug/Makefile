	-$(RM) $(OBJS_AS_ARGS) $(EXECUTABLES)  
	-$(RM) $(C_DEPS_AS_ARGS)   
	rm -rf "template_arduino_se.elf" "template_arduino_se.a" "template_arduino_se.hex" "template_arduino_se.lss" "template_arduino_se.eep" "template_arduino_se.map" "template_arduino_se.srec" "template_arduino_se.usersignatures"
	